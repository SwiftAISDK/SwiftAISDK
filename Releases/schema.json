{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "change": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "enum": [
            1
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "status": {
          "enum": [
            "draft",
            "reviewed"
          ]
        },
        "summary": {
          "type": "string"
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "package": {
                "type": "string"
              },
              "bump": {
                "enum": [
                  "initial",
                  "patch",
                  "minor",
                  "major"
                ]
              },
              "notes": {
                "type": "string"
              },
              "compatibility": {
                "type": "string"
              }
            },
            "required": [
              "package",
              "bump",
              "notes",
              "compatibility"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "status",
        "summary",
        "packages"
      ],
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string"
        },
        "from": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "package",
        "from"
      ],
      "additionalProperties": false
    },
    "releasedPackage": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "exportSHA256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "exportCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "tagObject": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        }
      },
      "required": [
        "package",
        "version",
        "exportSHA256",
        "sourceCommit",
        "exportCommit",
        "tagObject",
        "dependencies"
      ],
      "additionalProperties": false
    },
    "releaseSet": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "enum": [
            1
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "status": {
          "enum": [
            "published"
          ]
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "changeIDs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/releasedPackage"
          }
        },
        "consumerVerificationSHA256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "status",
        "sourceCommit",
        "changeIDs",
        "packages",
        "consumerVerificationSHA256"
      ],
      "additionalProperties": false
    }
  }
}
